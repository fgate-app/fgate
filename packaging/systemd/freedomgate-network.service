[Unit]
Description=FreedomGate privileged network helper
Documentation=https://github.com/freedomgate/freedomgate
After=network.target
Before=freedomgate.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/freedomgate/current/scripts/freedomgate-network-helper.sh run
Environment=NODE_ENV=production
Environment=FREEDOMGATE_RUN_DIR=/run/freedomgate
Environment=FREEDOMGATE_STATE_DIR=/var/lib/freedomgate
Environment=FREEDOMGATE_NODE=/opt/freedomgate/runtime/node/bin/node
RuntimeDirectory=freedomgate
RuntimeDirectoryMode=0755
# The web unit owns this directory. A root StateDirectory would recursively
# change its owner and make SQLite inaccessible to the unprivileged web process.
ReadWritePaths=/var/lib/freedomgate
Restart=on-failure
RestartSec=3
# The helper is the only root network owner; it must not gain extra privileges.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/freedomgate/modules /opt/freedomgate/module-updates
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectControlGroups=true
RestrictSUIDSGID=true
# hostapd needs AF_NETLINK (nl80211) and AF_PACKET (EAPOL).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
CapabilityBoundingSet=CAP_KILL CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_OVERRIDE CAP_CHOWN CAP_SETGID CAP_SETUID
AmbientCapabilities=CAP_KILL CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_OVERRIDE CAP_CHOWN CAP_SETGID CAP_SETUID

[Install]
WantedBy=multi-user.target
