[Unit]
Description=FreedomGate local administration
After=network.target freedomgate-network.service
Wants=freedomgate-network.service

[Service]
Type=simple
User=freedomgate
Group=freedomgate
SupplementaryGroups=video systemd-journal
WorkingDirectory=/opt/freedomgate/current
ExecStart=/opt/freedomgate/runtime/node/bin/node server/index.js
Environment=NODE_ENV=production
Environment=FREEDOMGATE_DB=/var/lib/freedomgate/freedomgate.sqlite
Environment=PORT=80
Environment=FREEDOMGATE_APPLY_NETWORK_ON_START=1
Environment=HOST=0.0.0.0
EnvironmentFile=-/etc/freedomgate/freedomgate.env
RuntimeDirectory=freedomgate-cloud-ssh-client
RuntimeDirectoryMode=0700
Environment=FREEDOMGATE_SSH_RUNTIME_DIR=/run/freedomgate-cloud-ssh-client
StateDirectory=freedomgate
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# mihomo's auto-route writes sysctls for the TUN.
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# listInterfaces runs ip (netlink); mihomo's TUN also needs packet sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
# mihomo opens /dev/net/tun and installs the TUN routes itself.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
