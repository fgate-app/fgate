{
  "name": "freedomgate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/auth-browser.mjs",
    "test:browser:dialogs": "node tests/unsaved-dialog-browser.mjs",
    "test:browser:motion": "node tests/overlay-motion-browser.mjs",
    "test:browser:colors": "node tests/colors-browser.mjs",
    "test:browser:typography": "node tests/typography-browser.mjs",
    "test:browser:pwa": "node tests/pwa-browser.mjs",
    "test:browser:dns": "node tests/dns-browser.mjs",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --disable-telemetry",
    "pretest": "scripts/build-outline.sh",
    "test:outline": "cd server/outline && go test -mod=vendor ./...",
    "audit:code": "node scripts/audit-code.mjs"
  },
  "dependencies": {
    "@fontsource/ubuntu": "5.3.0",
    "@mdi/js": "7.4.47",
    "d3": "7.9.2",
    "qrcode": "1.5.4",
    "simple-icons": "16.36.0",
    "vue": "^3.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/vue3-vite": "10.6.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "storybook": "10.6.6",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
